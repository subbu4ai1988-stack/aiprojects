APP_ENV=development
DATABASE_URL=sqlite:///backend/data/recruitai.db
JWT_SECRET=local-development-secret-change-in-production
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://127.0.0.1:5173
LOG_LEVEL=INFO
AUTO_CREATE_SCHEMA=true
BOOTSTRAP_DEMO_USERS=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
MAX_UPLOAD_MB=25

AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=45
AI_MAX_CALLS_PER_MINUTE=30
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RESET_SECONDS=60
AI_MONTHLY_TOKEN_BUDGET=0
ASYNC_AI_JOBS=false
AI_WORKER_POLL_SECONDS=2
AI_WORKER_MAX_ATTEMPTS=3
STORAGE_PROVIDER=local
STORAGE_SIGNED_URL_SECONDS=900
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=recruitai
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MINIO_ROOT_USER=recruitai
MINIO_ROOT_PASSWORD=

EMAIL_PROVIDER=local
EMAIL_FROM=recruitai@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_MAX_ATTEMPTS=3

TRANSCRIPTION_PROVIDER=local
